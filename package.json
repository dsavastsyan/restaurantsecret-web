{
  "name": "restaurantsecret-web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": "^20.0.0"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/generate-spa-entrypoints.js && node scripts/generate-sitemap.js",
    "build:preview": "npm run build && node scripts/prepare-preview-service-worker.js",
    "preview": "vite preview --port 5173",
    "test": "npm run test:unit",
    "test:unit": "node --test tests/*.test.js tests/*.test.mjs",
    "test:api-contract": "node --test tests/api-contract.test.mjs",
    "test:api-contract:live": "API_CONTRACT_LIVE=1 node --test tests/api-contract.test.mjs",
    "test:e2e": "npx playwright test"
  },
  "dependencies": {
    "@maplibre/maplibre-gl-leaflet": "^0.1.4",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^1.27.0",
    "maplibre-gl": "^6.11.2",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.26.1",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.4.0"
  },
  "overrides": {
    "@mapbox/jsonlint-lines-primitives": "2.0.2"
  }
}
